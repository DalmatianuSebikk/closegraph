node_modules/
# vendor/ stays ignored EXCEPT the grammar wasms the pack runtime loads —
# they are committed binaries (see vendor/grammars/PROVENANCE.md); a parent
# dir exclusion cannot be re-included, so vendor/ is ignored per-entry here
vendor/*
!vendor/grammars/
vendor/grammars/*
!vendor/grammars/*.wasm
!vendor/grammars/PROVENANCE.md
dist/
*.log
.superpowers/

# build output
build/
coverage/
*.tsbuildinfo

# local noise
.DS_Store
.idea/

# secrets — never commit
.env
.env.*

# graph artifacts (snapshot output from Task 6/13 tooling)
*.snapshot.json
.closegraph.snapshot.json.tmp-*

# security-research artifacts (cybermes phase-2 convention)
reports/

# private — never published (stripped from history before first push)
docs/
research/
tests/
task-*-report.md

# dev-process scratch — never disclose the making-of
scratch/
